# Engineering Foundry environment.
#
# Variable NAMES only. Never commit a real value to this repository.
#
# Anything prefixed NEXT_PUBLIC_ is inlined into the browser bundle and is
# public by definition. Everything else is server-only and must exist solely in
# the trusted server runtime.
#
# Capabilities are independent. The public preparation product needs none of
# these; each additional capability declares exactly what it requires. See
# lib/config/capabilities.ts and docs/production-launch-checklist.md.

# ---------------------------------------------------------------------------
# Required — public site (browser-safe)
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=https://engineeringfoundry.dev
NEXT_PUBLIC_DISCORD_URL=https://discord.gg/cNgNq3AFGX

# ---------------------------------------------------------------------------
# Capability: account platform (browser-safe)
# Required together: authentication, private workspaces, all persistence.
# With any of these absent or the flag off, the public product still works and
# every private control stays out of the UI.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Master gate. Keep false until the hosted qualification in
# docs/production-launch-checklist.md is complete. This is also the emergency
# rollback switch: setting it false disables accounts without a code change.
NEXT_PUBLIC_ACCOUNTS_ENABLED=false

# ---------------------------------------------------------------------------
# Optional — OAuth providers (browser-safe feature flags)
# Set true only where the provider is configured and verified in Supabase.
# Provider client IDs and secrets belong in the Supabase dashboard, never here.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_GOOGLE_AUTH_ENABLED=false
NEXT_PUBLIC_GITHUB_AUTH_ENABLED=false

# ---------------------------------------------------------------------------
# Optional — analytics (browser-safe)
# Absent key disables analytics entirely. Private routes are never measured;
# see lib/privacy/routes.ts.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# Optional — shown in public contact copy (browser-safe)
NEXT_PUBLIC_CONTACT_EMAIL=

# ---------------------------------------------------------------------------
# SERVER-ONLY. Never prefix any of the following with NEXT_PUBLIC_.
# ---------------------------------------------------------------------------

# Capability: permanent account deletion (production).
# Privileged Supabase Auth admin credential. Required for the delete-account
# flow; without it the delete control renders as explicitly unavailable rather
# than appearing operational. Also used by the reminder worker.
SUPABASE_SERVICE_ROLE_KEY=

# Capability: reminder worker (production).
# Shared secret for POST /api/internal/reminders/process. The route rejects
# every request when this is unset, so an unconfigured deployment cannot expose
# an anonymously callable worker. Requires SUPABASE_SERVICE_ROLE_KEY as well,
# plus an external HTTPS scheduler to invoke it.
REMINDER_WORKER_SECRET=

# Capability: email reminders — NOT AVAILABLE.
# Reserved for a future provider adapter. Setting this changes nothing today:
# lib/interview-reminders/provider.ts intentionally ships no adapter, so email
# delivery is unimplemented rather than unconfigured. In-app reminders work
# without it, and the email toggle stays disabled with an honest explanation.
REMINDER_EMAIL_PROVIDER=
